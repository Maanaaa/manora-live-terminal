# API Manora Live
API_URL=https://api.live.manora-photo.fr
TERMINAL_ID=pi-manora
TERMINAL_KEY=
# Mosquitto local (compte « passerelle », voir ~/.config/manora/mqtt.env sur le Pi)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=passerelle
MQTT_PASSWORD=
# Optionnel
Z2M_BASE_TOPIC=zigbee2mqtt
HEARTBEAT_MS=30000
